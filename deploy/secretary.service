[Unit]
Description=My Secretary FastAPI service
After=network-online.target time-sync.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=jb223
WorkingDirectory=/home/pi/my-secretary/backend
# Binds 0.0.0.0 (not 127.0.0.1) so the Google Home speaker can fetch the TTS MP3
# from http://<GOOGLE_HOME_LAN_IP>:8000/tts-audio/... over the LAN. nginx still
# proxies the API; this just additionally exposes 8000 on the LAN for casting.
ExecStart=/home/jb223/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
